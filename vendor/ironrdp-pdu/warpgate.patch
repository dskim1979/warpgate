+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const KEYBOARD_TYPE_OFFSET: usize = VERSION_SIZE
+        + DESKTOP_WIDTH_SIZE
+        + DESKTOP_HEIGHT_SIZE
+        + COLOR_DEPTH_SIZE
+        + SEC_ACCESS_SEQUENCE_SIZE
+        + KEYBOARD_LAYOUT_SIZE
+        + CLIENT_BUILD_SIZE
+        + CLIENT_NAME_SIZE;
+
+    /// Required part of a TS_UD_CS_CORE as sent by Korean Windows mstsc (no optional part).
+    fn client_core_data_with_keyboard_type(keyboard_type: u32) -> Vec<u8> {
+        let mut buf = Vec::new();
+        buf.extend_from_slice(&RdpVersion::V5_PLUS.0.to_le_bytes());
+        buf.extend_from_slice(&1920u16.to_le_bytes());
+        buf.extend_from_slice(&1080u16.to_le_bytes());
+        buf.extend_from_slice(&0xCA01u16.to_le_bytes()); // colorDepth: 8bpp
+        buf.extend_from_slice(&0xAA03u16.to_le_bytes()); // SASSequence: Del
+        buf.extend_from_slice(&0x0000_0412u32.to_le_bytes()); // keyboardLayout: ko-KR
+        buf.extend_from_slice(&26100u32.to_le_bytes()); // clientBuild
+        let mut name = utils::to_utf16_bytes("KR-PC");
+        name.resize(CLIENT_NAME_SIZE, 0);
+        buf.extend_from_slice(&name);
+        buf.extend_from_slice(&keyboard_type.to_le_bytes());
+        buf.extend_from_slice(&3u32.to_le_bytes()); // keyboardSubType: 103/106-key Korean
+        buf.extend_from_slice(&12u32.to_le_bytes()); // keyboardFunctionKey
+        buf.extend_from_slice(&[0u8; IME_FILE_NAME_SIZE]);
+        assert_eq!(buf.len(), ClientCoreData::FIXED_PART_SIZE);
+        assert_eq!(
+            u32::from_le_bytes(buf[KEYBOARD_TYPE_OFFSET..KEYBOARD_TYPE_OFFSET + 4].try_into().unwrap()),
+            keyboard_type
+        );
+        buf
+    }
+
+    #[test]
+    fn decodes_korean_keyboard_type() {
+        let buf = client_core_data_with_keyboard_type(8);
+        let data = ClientCoreData::decode(&mut ReadCursor::new(&buf)).expect("keyboardType 8 must decode");
+        assert_eq!(data.keyboard_type, KeyboardType::Korean);
+        assert_eq!(data.keyboard_type.as_u32(), 8);
+        assert_eq!(data.keyboard_layout, 0x0412);
+        assert_eq!(data.keyboard_subtype, 3);
+        assert_eq!(data.client_name, "KR-PC");
+    }
+
+    #[test]
+    fn unknown_keyboard_type_does_not_fail() {
+        for value in [0u32, 9, 0x51, 0xFFFF_FFFF] {
+            let buf = client_core_data_with_keyboard_type(value);
+            let data = ClientCoreData::decode(&mut ReadCursor::new(&buf)).expect("unknown keyboardType must decode");
+            assert_eq!(data.keyboard_type, KeyboardType::IbmEnhanced);
+        }
+    }
+
+    #[test]
+    fn known_keyboard_types_round_trip() {
+        for value in 1u32..=8 {
+            let buf = client_core_data_with_keyboard_type(value);
+            let data = ClientCoreData::decode(&mut ReadCursor::new(&buf)).unwrap();
+            assert_eq!(data.keyboard_type.as_u32(), value);
+        }
+    }
+}
