+    Korean = 8,
 }
 
 impl KeyboardType {
+    /// Like `from_u32`, but maps unknown values to `IbmEnhanced` instead of failing.
+    pub fn from_u32_lenient(value: u32) -> Self {
+        Self::from_u32(value).unwrap_or(Self::IbmEnhanced)
+    }
